{
  "name": "royal-fashion-monorepo",
  "private": false,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    },
    "onlyBuiltDependencies": [
      "@medusajs/telemetry",
      "supabase"
    ]
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "supabase": "2.120.0",
    "turbo": "^2.0.14"
  }
}